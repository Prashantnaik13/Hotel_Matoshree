PORT=5000
NODE_ENV=development
DB_DIALECT=sqlite
# For MySQL production, set:
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=hotel_pos_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# For sqlite dev:
SQLITE_STORAGE=./database.sqlite
JWT_SECRET=your_super_strong_jwt_secret_change_this_in_production_123456
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
BCRYPT_ROUNDS=10
